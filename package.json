{
  "name": "formiqo",
  "version": "1.0.0",
  "description": "Make Markdown beautiful. Intelligent Markdown formatting, paste correction, and Reading View enhancements for Obsidian.",
  "author": "cachewraith",
  "license": "MIT",
  "homepage": "https://github.com/cachewraith/formiqo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cachewraith/formiqo.git"
  },
  "bugs": {
    "url": "https://github.com/cachewraith/formiqo/issues"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "markdown",
    "formatter",
    "markdown-tables"
  ],
  "main": "dist/main.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun esbuild.config.mjs",
    "build": "bun esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "bun scripts/verify-artifacts.mjs",
    "validate": "bun run typecheck && bun run lint && bun run test && bun run build && bun run verify"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "happy-dom": "^21.0.4",
    "obsidian": "^1.14.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
